# Интерфейс CrewAI: для Polza AI впишите openai.
LLM_PROVIDER=
# Полный ID Polza AI: для выбранной модели deepseek/deepseek-v4.1-flash.
LLM_MODEL=
# Секретный API-ключ: впишите только в локальный .env, не отправляйте в чат.
LLM_API_KEY=
# Для Polza AI впишите https://polza.ai/api/v1.
LLM_BASE_URL=
# Отдельный ключ Tavily из https://app.tavily.com — только в локальном .env.
# В проекте всегда basic-поиск; advanced и auto_parameters отключены.
TAVILY_API_KEY=
