# Интерфейс LLM в CrewAI, например openai для совместимого API.
LLM_PROVIDER=
# Полный идентификатор модели из каталога выбранного провайдера.
LLM_MODEL=
# Секретный ключ LLM API — заполняется только в локальном .env.
LLM_API_KEY=
# Базовый URL API выбранного провайдера.
LLM_BASE_URL=
# Ключ поиска Tavily, заполняется только локально.
# Используется basic-поиск; advanced и auto_parameters отключены.
TAVILY_API_KEY=

# Разрешённый origin интерфейса, без пути и завершающего /.
API_CORS_ORIGIN=http://localhost:5173
