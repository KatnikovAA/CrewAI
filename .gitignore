# Локальные секреты; публикуем только пустой шаблон настроек.
.env
.env.*
!.env.example
# Окружение, сборка и автоматически созданные файлы.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
# Служебное хранилище CrewAI остаётся на компьютере.
.crewai/

# Frontend dependencies and local builds.
frontend/node_modules/
frontend/dist/

# Desktop launcher state and local logs.
.launcher/
# Local streaming run diagnostics.
*.diagnostics.jsonl
